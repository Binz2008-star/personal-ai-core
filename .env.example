# Personal AI Core V1 configuration template.
# Copy to .env only if your process launcher loads dotenv files; PAC itself
# reads environment variables and does not parse .env files automatically.
# Never commit .env or real credentials.

# Core model/runtime
PAC_BOSS_MODEL=huihui_ai/qwen2.5-abliterate:7b
PAC_BOSS_CONTEXT_WINDOW=8192
PAC_OLLAMA_HOST=http://127.0.0.1:11434
PAC_REQUEST_TIMEOUT_SECONDS=120
PAC_LANGUAGE_GUARD=1

# Core persistent state.
# Use an absolute, environment-specific path in production.
# PAC_DATABASE=C:/path/to/production/core.db

# Owner profile. If omitted, PAC uses profile.md beside the core database.
# PAC_PROFILE=C:/path/to/production/profile.md

# OpenCode/PAC integration state MUST remain separate from core.db.
# If omitted, the integration uses ~/.personal-ai-core/opencode.db.
# PAC_OPENCODE_DATABASE=C:/path/to/production/opencode.db
